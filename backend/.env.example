# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection URI
MONGODB_URI=mongodb://localhost:27017/lumen_cms

# JWT Authentication Secret & Expiration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Frontend Client Origin
CLIENT_URL=http://localhost:5173

# Optional AI writing suggestions and content moderation (Google Gemini API Key)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_CONTENT_MODEL=gemini-2.5-flash

# Groq AI Service (Article Summarization & Content Suggestions)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen-2.5-32b
GROQ_BASE_URL=https://api.groq.com/openai/v1